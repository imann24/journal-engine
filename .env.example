# Copy to .env and fill in. .env is gitignored — NEVER commit it.
# The web UI refuses to start unless JOURNAL_PASSWORD is set.

# REQUIRED: single password gating the entire web UI.
JOURNAL_PASSWORD=change-me-to-something-long

# Persistent login ("remember this browser") is via an HMAC-signed cookie.
# Optional: a stable signing secret. If unset, the token is derived from the
# password (so changing the password logs every browser out).
# JOURNAL_AUTH_SECRET=some-long-random-string
# JOURNAL_AUTH_DAYS=30        # how long the remember-me cookie lasts

# --- Optional overrides (defaults shown) ---
# Ollama is local to the Spark; keep generation/embeddings on localhost.
# OLLAMA_HOST=http://localhost:11434

# Models (must be pulled in Ollama: `ollama pull bge-m3`, etc.)
# JOURNAL_EMBED_MODEL=bge-m3
# JOURNAL_EMBED_DIM=1024
# JOURNAL_CHAT_MODEL=nemotron-3-super:latest   # nemotron-3-nano:latest is faster for bulk enrich

# Storage / folders
# JOURNAL_DB=./journal_lancedb
# JOURNAL_DROP_DIR=./drop

# Web server (bind 0.0.0.0 so the Mac can reach it over Tailscale; tailnet-only)
# JOURNAL_WEB_HOST=0.0.0.0
# JOURNAL_WEB_PORT=8501

# Chunking
# JOURNAL_CHUNK_WORDS=400
# JOURNAL_CHUNK_OVERLAP=1
# JOURNAL_EMBED_BATCH=64
